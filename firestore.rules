rules_version = '2';

// Security rules for the V-Plus website database (Cloud Firestore).
// Paste this into Firebase console → Firestore Database → Rules → Publish.
// Staff list must match STAFF_EMAILS in js/firebase-config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isStaff() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'rajiv@vpluspackagingrwanda.com',
          'info@vpluspackagingrwanda.com',
          'sales@vpluspackagingrwanda.com'
        ];
    }

    function str(v, max) { return v is string && v.size() <= max; }

    // Customer profiles: users/{uid}
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'company', 'email', 'countryCode', 'phone', 'createdAt', 'updatedAt'])
        && str(request.resource.data.name, 120)
        && str(request.resource.data.company, 160)
        && str(request.resource.data.email, 200)
        && str(request.resource.data.countryCode, 60)
        && str(request.resource.data.phone, 40);
      allow delete: if false;
    }

    // Quote requests from the website: quotes/{id}
    match /quotes/{id} {
      // Anyone can send a quote (logged in or not). Logged-in customers are linked by uid.
      allow create: if request.resource.data.keys().hasOnly(
            ['uid', 'name', 'company', 'email', 'country', 'countryCode', 'phone', 'product', 'quantity', 'details', 'status', 'createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid))
        && str(request.resource.data.name, 120) && request.resource.data.name.size() > 0
        && str(request.resource.data.email, 200) && request.resource.data.email.size() > 3
        && str(request.resource.data.company, 160)
        && str(request.resource.data.country, 80)
        && str(request.resource.data.countryCode, 10)
        && str(request.resource.data.phone, 40)
        && str(request.resource.data.product, 120)
        && str(request.resource.data.quantity, 120)
        && str(request.resource.data.details, 5000);

      // Customers see their own quotes; staff see all.
      allow read: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);

      // Only staff can change the status / notes, or delete.
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])
        && request.resource.data.status in ['new', 'contacted', 'quoted', 'won', 'lost'];
      allow delete: if isStaff();
    }
  }
}
