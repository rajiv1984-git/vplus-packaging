rules_version = '2';

// Security rules for the V-Plus website database (Cloud Firestore).
// Account types: customer, staff, admin, superadmin (only one – identified by its UID below).
// Paste into Firebase console → Firestore Database → Rules → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- who is asking ----------
    function signedIn() { return request.auth != null; }
    function superUid() { return 'SUPER_UID_HERE'; }
    function isSuper() { return signedIn() && request.auth.uid == superUid(); }
    function myPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasRole(r) { return signedIn() && exists(myPath()) && get(myPath()).data.role == r && get(myPath()).data.active == true; }
    function isAdmin() { return isSuper() || hasRole('admin'); }
    function isStaff() { return isAdmin() || hasRole('staff'); }

    function settingsPath() { return /databases/$(database)/documents/settings/auth; }
    function signupOpen() { return !exists(settingsPath()) || get(settingsPath()).data.customerSignup != false; }

    function str(v, max) { return v is string && v.size() <= max; }
    function validUser(d) {
      return d.keys().hasOnly(['name', 'company', 'email', 'countryCode', 'phone', 'role', 'active', 'username',
                              'createdAt', 'createdBy', 'createdByName', 'updatedAt', 'lastLogin'])
        && str(d.name, 120) && str(d.email, 200)
        && d.role in ['customer', 'staff', 'admin', 'superadmin'] && d.active is bool;
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function STATUSES() { return ['new', 'contacted', 'quoted', 'won', 'lost']; }

    // ---------- accounts: users/{uid} ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      // a customer signing up on the website (only while sign-up is switched on)
      allow create: if signedIn() && request.auth.uid == uid && signupOpen()
        && request.resource.data.role == 'customer' && request.resource.data.active == true
        && validUser(request.resource.data);

      // the Super Admin's own profile
      allow create: if isSuper() && uid == request.auth.uid
        && request.resource.data.role == 'superadmin' && request.resource.data.active == true
        && validUser(request.resource.data);

      // Admins create Staff; the Super Admin creates Admins (and Staff)
      allow create: if uid != request.auth.uid && validUser(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && ((isAdmin() && request.resource.data.role == 'staff')
            || (isSuper() && request.resource.data.role == 'admin'));

      // everyone may edit their own contact details (never their role or active state)
      allow update: if signedIn() && request.auth.uid == uid
        && changed().hasOnly(['name', 'company', 'countryCode', 'phone', 'email', 'updatedAt', 'lastLogin'])
        && validUser(request.resource.data);

      // Admins manage customers and staff
      allow update: if isAdmin() && uid != request.auth.uid
        && resource.data.role in ['customer', 'staff'] && request.resource.data.role in ['customer', 'staff']
        && changed().hasOnly(['role', 'active', 'name', 'updatedAt']);

      // the Super Admin also manages Admins
      allow update: if isSuper() && uid != request.auth.uid
        && resource.data.role != 'superadmin' && request.resource.data.role in ['customer', 'staff', 'admin']
        && changed().hasOnly(['role', 'active', 'name', 'updatedAt']);

      allow delete: if false;   // accounts are deactivated, never deleted
    }

    // ---------- quote requests: quotes/{id} ----------
    match /quotes/{id} {
      allow create: if request.resource.data.keys().hasOnly(
            ['uid', 'name', 'company', 'email', 'country', 'countryCode', 'phone', 'product', 'quantity', 'details', 'status', 'createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid))
        && str(request.resource.data.name, 120) && request.resource.data.name.size() > 0
        && str(request.resource.data.email, 200) && request.resource.data.email.size() > 3
        && str(request.resource.data.company, 160) && str(request.resource.data.country, 80)
        && str(request.resource.data.countryCode, 10) && str(request.resource.data.phone, 40)
        && str(request.resource.data.product, 120) && str(request.resource.data.quantity, 120)
        && str(request.resource.data.details, 5000);

      allow read: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);

      // Staff: status, history and notes counters
      allow update: if isStaff()
        && changed().hasOnly(['status', 'updatedAt', 'updatedBy', 'history', 'lastNote', 'notesCount'])
        && request.resource.data.status in STATUSES();

      // Admins: also assign quotes to staff
      allow update: if isAdmin()
        && changed().hasOnly(['status', 'updatedAt', 'updatedBy', 'history', 'lastNote', 'notesCount', 'assignedTo', 'assignedName'])
        && request.resource.data.status in STATUSES();

      allow delete: if isAdmin();

      // internal notes (never visible to customers)
      match /notes/{nid} {
        allow read: if isStaff();
        allow create: if isStaff() && request.resource.data.by == request.auth.uid
          && request.resource.data.keys().hasOnly(['text', 'by', 'byName', 'at'])
          && request.resource.data.at == request.time && str(request.resource.data.text, 2000);
        allow delete: if isAdmin();
      }
    }

    // ---------- login switches (Super Admin only) ----------
    match /settings/{doc} {
      allow read: if true;
      allow write: if isSuper();
    }

    // ---------- activity log ----------
    match /logs/{id} {
      allow create: if isStaff() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['action', 'details', 'by', 'byName', 'role', 'at'])
        && request.resource.data.at == request.time
        && str(request.resource.data.action, 80) && str(request.resource.data.details, 500);
      allow read: if isSuper();
    }
  }
}
